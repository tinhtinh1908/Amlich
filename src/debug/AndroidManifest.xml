<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.dtinh.lichviet.BlurProbeActivity" android:exported="true"/>
        <receiver android:name="com.dtinh.lichviet.BlurEnabledWidget" android:label="Amlich blur ON" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_blur_probe"/>
            <meta-data android:name="miuiWidget" android:value="true"/>
            <meta-data android:name="supportBackgroundBlur" android:value="true"/>
            <meta-data android:name="usingFolderGlassStyle" android:value="true"/>
        </receiver>
        <receiver android:name="com.dtinh.lichviet.BlurControlWidget" android:label="Amlich blur OFF" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_blur_probe"/>
            <meta-data android:name="supportBackgroundBlur" android:value="false"/>
            <meta-data android:name="usingFolderGlassStyle" android:value="false"/>
        </receiver>
    </application>
</manifest>
